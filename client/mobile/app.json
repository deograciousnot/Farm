{
  "expo": {
    "name": "FarmConnect",
    "slug": "farmconnect",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/farmconnect-icon.png",
    "scheme": "farmconnect",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "com.farmconnect.app",
      "adaptiveIcon": {
        "backgroundColor": "#fff8f1",
        "foregroundImage": "./assets/images/farmconnect-adaptive-foreground.png",
        "backgroundImage": "./assets/images/farmconnect-adaptive-background.png",
        "monochromeImage": "./assets/images/farmconnect-adaptive-monochrome.png"
      },
      "edgeToEdgeEnabled": true,
      "predictiveBackGestureEnabled": false,
      "permissions": []
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/farmconnect-favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "FarmConnect uses your photos so you can upload produce images and farm videos.",
          "cameraPermission": "FarmConnect uses the camera so you can capture fresh listings and post updates."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/farmconnect-splash-icon.png",
          "imageWidth": 220,
          "resizeMode": "contain",
          "backgroundColor": "#fff8f1",
          "dark": {
            "backgroundColor": "#171311"
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "eas": {
        "projectId": "e3e3ac51-4cae-45c4-b210-9809ad7eb572"
      }
    },
    "owner": "notsyx"
  }
}
