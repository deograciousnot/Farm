PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/farmconnect
MONGO_DNS_SERVERS=
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
ADMIN_SECRET=replace-with-a-private-admin-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS=http://localhost:8081
# SMS sign-in codes via Africa's Talking. Leave empty locally: codes print to the server console.
# Use AT_USERNAME=sandbox with a sandbox API key to test without sending real texts.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Production only: set to true to allow /api/admin/seed (it can wipe the database).
ALLOW_SEED=
