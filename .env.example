PORT=8000
MONGO_URI=mongodb://127.0.0.1:27017/farmconnect
MONGO_DNS_SERVERS=
JWT_SECRET=replace-with-a-strong-secret
JWT_EXPIRES_IN=7d
ADMIN_SECRET=replace-with-a-private-admin-secret
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
ALLOWED_ORIGINS=http://localhost:8081
# SMS sign-in codes via Africa's Talking. Leave empty locally: codes print to the server console.
# Use AT_USERNAME=sandbox with a sandbox API key to test without sending real texts.
AT_USERNAME=
AT_API_KEY=
AT_SENDER_ID=
# Email confirmation and password-reset codes via Resend. Leave empty locally: emails print to the server console.
# EMAIL_FROM must use a domain you've verified in Resend (onboarding@resend.dev only delivers to your own address).
RESEND_API_KEY=
EMAIL_FROM=
# M-Pesa STK push via Safaricom Daraja (developer.safaricom.co.ke). Leave the keys empty locally: payments are simulated.
# Sandbox: create an app on Daraja, paste its consumer key/secret, keep MPESA_ENV=sandbox (shortcode and passkey default to the test ones).
# MPESA_CALLBACK_BASE_URL must be this API's public https URL (use the Render URL, or an ngrok tunnel when testing locally).
MPESA_ENV=sandbox
MPESA_CONSUMER_KEY=
MPESA_CONSUMER_SECRET=
MPESA_SHORTCODE=
MPESA_PASSKEY=
MPESA_TRANSACTION_TYPE=CustomerPayBillOnline
MPESA_TILL_NUMBER=
MPESA_CALLBACK_BASE_URL=
MPESA_CALLBACK_SECRET=replace-with-a-long-random-string
# Production only: set to true to allow /api/admin/seed (it can wipe the database).
ALLOW_SEED=
